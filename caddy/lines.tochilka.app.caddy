lines.tochilka.app {
    root * /var/www/lines.tochilka.app
    encode gzip

    # Node.js API (заглушка на будущее)
    handle /api/v2/* {
        reverse_proxy 127.0.0.1:3001
    }

    # SPA
    handle {
        try_files {path} /index.html
        file_server
    }

    header /index.html Cache-Control "no-cache, no-store, must-revalidate"
    header /assets/* Cache-Control "public, max-age=2592000, immutable"
}
